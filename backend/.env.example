# Application
APP_NAME=Praksha Academy API
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=praksha_app
DB_PASSWORD=change_me
DB_NAME=praksha_academy_dev

# Security — generate strong secrets before production
JWT_SECRET_KEY=change_me_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password hashing
BCRYPT_ROUNDS=12
