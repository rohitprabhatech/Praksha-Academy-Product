# Frontend environment (copy to .env.local if needed)
# When true, AuthContext uses mock users (Sprint 02/03 bridge).
# Set to false once Sprint 03 auth APIs are live.
VITE_USE_MOCK_AUTH=true

# API prefix used by axios. With Vite proxy, keep /api/v1 in development.
VITE_API_BASE_URL=/api/v1

# Public website tenant (until subdomain routing exists).
# Must match owner user tenantId used when saving Website CMS drafts.
VITE_PUBLIC_TENANT_ID=mock-tenant-a
